# Copy to .env and set HF_TOKEN for gated models (Llama, etc.)
#   cp .env.example .env

CONDA_ENVS_PATH=
CONDA_PKGS_DIRS=
HF_HOME=
HF_HUB_CACHE=${HF_HOME}/hub
HF_TOKEN=
BNB_CUDA_VERSION=126

# Training hyperparameters
STUDENT_MODEL=Qwen/Qwen2.5-3B-Instruct
TEACHER_MODEL=Qwen/Qwen2.5-7B-Instruct
TRAIN_NUM_GPUS=3
TRAIN_MAX_STEPS=100
TRAIN_EPOCHS=10
LEARNING_RATE=5e-5
DPO_BETA=0.1
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
LORA_TARGET=all-linear
MAX_LENGTH=12288
TRAIN_BATCH_SIZE=1
GRAD_ACCUM=8
WARMUP_RATIO=0.05
LR_SCHEDULER=cosine
LOGGING_STEPS=10
SAVE_STEPS=20
SAVE_TOTAL_LIMIT=100
USE_4BIT=true
BNB_4BIT_QUANT_TYPE=nf4
BNB_4BIT_COMPUTE_DTYPE=float16
GRADIENT_CHECKPOINTING=true
FP16=false
BF16=false

# Evaluation hyperparameters
EVAL_EPISODES=12
EVAL_SEED=42
EVAL_MAX_TOKENS=192
EVAL_VARIANTS=base,core
EVAL_GAMES=all
MERGE_ALPHA=0.5
